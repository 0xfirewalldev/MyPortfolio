---
<div class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2" aria-hidden="true">
  <span class="font-mono text-xs tracking-[0.3em] text-neutral-500">DISCOVER</span>
  <span class="relative h-10 w-px overflow-hidden bg-white/10">
    <span class="scroll-line absolute inset-x-0 bg-zinc-400"></span>
  </span>
</div>

<style>
  .scroll-line { animation: scroll-line 1.6s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
  @keyframes scroll-line {
    0%   { top: 0;    height: 0; }
    40%  { top: 0;    height: 80%; }
    100% { top: 80%; height: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .scroll-line { animation: none; height: 100%; } }
</style>