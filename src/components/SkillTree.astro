---
import { Icon } from "astro-icon/components";

const tone = {
  build: {
    icon: "lucide:hammer",
    head: "bg-blue-400 text-zinc-950",
    card: "border-zinc-200 bg-white md:after:absolute md:after:top-1/2 md:after:left-full md:after:w-8 md:after:border-t md:after:border-dashed md:after:border-zinc-300",
    title: "text-zinc-700",
    chip: "border-zinc-200 text-zinc-600 hover:border-blue-400 hover:text-zinc-900",
  },
  break: {
    icon: "lucide:bug",
    head: "bg-zinc-950 text-lime-400",
    card: "border-zinc-800 bg-zinc-950",
    title: "text-zinc-100",
    chip: "border-zinc-800 text-zinc-400 hover:border-lime-400 hover:text-lime-400",
  },
} as const;

type Tone = keyof typeof tone;

// Edit the leaves. Keep only what you can defend in an interview.
const tree: { id: Tone; label: string; nodes: { title: string; leaves: string[] }[] }[] = [
  {
    id: "build",
    label: "Build",
    nodes: [
      { title: "Frontend", leaves: ["Next.js", "React Native / Expo", "Tailwind", "GSAP"] },
      { title: "Backend", leaves: ["Server actions", "Hono", "BullMQ", "OAuth / PKCE"] },
      { title: "Data", leaves: ["Prisma", "Drizzle", "Supabase", "Postgres"] },
    ],
  },
  {
    id: "break",
    label: "Break",
    nodes: [
      { title: "Client-side", leaves: ["XSS", "CSRF", "CSP review", "Auth flow abuse"] },
      { title: "Server-side", leaves: ["Broken access control", "IDOR", "Injection", "Sessions"] },
      { title: "Data exposure", leaves: ["RLS bypass", "Secrets leakage", "Misconfig"] },
    ],
  },
];
---

<div
  id="skill-tree"
  class="col-span-1 rounded-xl border border-zinc-200 bg-white p-4 md:col-span-6 md:p-8"
>
  <div class="flex items-center justify-between">
    <span class="font-mono text-xs uppercase tracking-widest text-blue-400">System_Map</span>
    <span class="font-mono text-xs uppercase tracking-widest text-zinc-500" aria-hidden="true">
      Build ↔ Break
    </span>
  </div>

  <!-- Root + elbow connector -->
  <div class="mt-8 flex flex-col items-center">
    <div
      data-tree-reveal
      class="flex items-center gap-2 rounded-full bg-zinc-950 px-4 py-2 font-mono text-xs text-zinc-100"
    >
      <span class="text-blue-400" aria-hidden="true">
        $
      </span>
      target: website
    </div>
    <span class="h-6 w-px bg-zinc-300" aria-hidden="true"></span>
    <div class="hidden w-full grid-cols-2 gap-x-8 md:grid" aria-hidden="true">
      <div class="-mr-4 ml-[50%] h-6 rounded-tl-lg border-t border-l border-zinc-300"></div>
      <div class="mr-[50%] -ml-4 h-6 rounded-tr-lg border-t border-r border-zinc-300"></div>
    </div>
  </div>

  <!-- Branches: subgrid keeps Build and Break rows aligned -->
  <ul class="mt-6 grid gap-x-8 gap-y-6 md:mt-0 md:grid-cols-2 md:grid-rows-[auto_repeat(3,1fr)]">
    {tree.map((branch) => {
      const t = tone[branch.id];
      return (
        <li class="relative isolate flex flex-col gap-4 md:row-span-4 md:grid md:grid-rows-subgrid before:absolute before:top-4 before:bottom-6 before:left-1/2 before:-z-10 before:w-px before:bg-zinc-300">
          <h3
            data-tree-reveal
            class:list={[
              "mx-auto flex h-fit w-fit items-center gap-2 rounded-full px-4 py-1.5 font-mono text-xs tracking-widest uppercase",
              t.head,
            ]}
          >
            <Icon name={t.icon} class="size-3.5" aria-hidden="true" />
            {branch.label}
          </h3>

          <ul class="flex flex-col gap-4 md:row-span-3 md:grid md:grid-rows-subgrid md:gap-6">
            {branch.nodes.map((node) => (
              <li
                data-tree-reveal
                class:list={["relative rounded-xl border p-4 shadow-xs", t.card]}
              >
                <h4 class:list={["font-display text-lg tracking-tight", t.title]}>{node.title}</h4>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {node.leaves.map((leaf) => (
                    <li
                      class:list={[
                        "rounded-full border px-2.5 py-1 font-mono text-xs transition-colors",
                        t.chip,
                      ]}
                    >
                      {leaf}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </li>
      );
    })}
  </ul>
</div>

<script>
  import { inView, animate, stagger } from "motion";

  function initSkillTree() {
    const root = document.querySelector<HTMLElement>("#skill-tree");
    if (!root) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const items = root.querySelectorAll<HTMLElement>("[data-tree-reveal]");
    if (items.length === 0) return;

    inView(
      root,
      () => {
        animate(
          items,
          { opacity: [0, 1], y: [16, 0] },
          { delay: stagger(0.06), duration: 0.6, ease: [0.16, 1, 0.3, 1] }
        );
      },
      { margin: "-5% 0px" }
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSkillTree);
  } else {
    initSkillTree();
  }

  document.addEventListener("astro:page-load", initSkillTree);
</script>
