---
import { Icon } from "astro-icon/components";

const channels = [
  {
    name: "GitHub",
    handle: "@0xfirewalldev",
    href: "https://github.com/0xfirewalldev",
    icon: "simple-icons:github",
    desc: "Repositories, audits & security labs",
  },
  {
    name: "Twitter / X",
    handle: "@DevTech_Coder23",
    href: "https://twitter.com/DevTech_Coder23",
    icon: "simple-icons:x",
    desc: "Tech insights, AppSec & build updates",
  },
  {
    name: "Technical Blog",
    handle: "zero-js-blog",
    href: "https://zero-js-blog.vercel.app",
    icon: "lucide:zap",
    desc: "Zero-JS architecture & vulnerability deep dives",
  },
];
---

<main class="mx-auto max-w-5xl pb-24">
  <!-- Back to Home Link -->
  <div class="pt-4">
    <a
      href="/"
      class="flex w-fit items-center gap-2 font-mono text-xs uppercase tracking-wider text-zinc-500 transition-colors hover:text-zinc-900"
    >
      <Icon name="lucide:arrow-left" class="size-3.5" /> Back To Home
    </a>
  </div>

  <!-- Header -->
  <header data-contact-header class="mt-8 space-y-4 border-b border-zinc-200 pb-6">
    <div class="flex items-center justify-between">
      <span class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-blue-500">
        <span class="size-1.5 animate-pulse rounded-full bg-blue-500"></span>
        SYS_COMMUNICATION // ENCRYPTED_CHANNEL
      </span>
      <span class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-zinc-500">
        <span class="size-1.5 rounded-full bg-lime-500"></span>
        STATUS: AVAILABLE_FOR_HIRE
      </span>
    </div>

    <div>
      <h1 class="font-display text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl md:text-4xl">
        Initiate Transmission & Contact
      </h1>
      <p class="mt-2 max-w-2xl text-xs sm:text-sm leading-relaxed text-zinc-600">
        Open for full-stack engineering roles, technical contract work, and web application
        penetration testing audits. Direct and verified communication channels below.
      </p>
    </div>
  </header>

  <!-- Main Grid Content -->
  <div class="mt-8 grid grid-cols-1 items-start gap-6 lg:grid-cols-12">
    <!-- Left Column: Primary Dispatch & Message Card -->
    <div data-contact-left class="flex flex-col gap-6 lg:col-span-7">
      <div class="flex flex-col rounded-xl border border-zinc-200 bg-white p-4 sm:p-6 shadow-xs md:p-8">
        <div>
          <span class="flex w-fit items-center gap-2 rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 font-mono text-xs text-zinc-600">
            <Icon name="lucide:mail" class="size-3.5 text-blue-500" aria-hidden="true" />
            Direct Ingress
          </span>

          <h2 class="font-display mt-5 text-xl font-bold tracking-tight text-zinc-900 sm:text-2xl md:text-3xl">
            Let’s engineer something resilient.
          </h2>

          <p class="mt-3 text-sm leading-relaxed text-zinc-600">
            Whether you need a high-performance web application built from zero, an existing
            codebase hardened against vulnerabilities, or an offensive security audit of your API
            and session layers—I’m ready to collaborate.
          </p>

          <div class="mt-5 flex flex-wrap items-center gap-2 rounded-lg border border-zinc-100 bg-zinc-50/70 p-3 font-mono text-xs text-zinc-600">
            <span class="flex items-center gap-1.5 text-emerald-600 font-medium">
              <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              STATUS: OPEN FOR NEW CONTRACTS
            </span>
            <span class="text-zinc-300 hidden sm:inline">•</span>
            <span class="text-zinc-500">SECURITY: ZERO-KNOWLEDGE READY</span>
          </div>
        </div>

        <div class="mt-6 flex flex-col sm:flex-row sm:items-center gap-3 border-t border-zinc-100 pt-6">
          <a
            href="mailto:kesienamichaels@gmail.com"
            class="flex items-center justify-center gap-2 rounded-full bg-zinc-900 px-6 py-3 font-sans text-sm font-medium text-zinc-100 transition-colors hover:bg-zinc-800 w-full sm:w-auto"
          >
            <span>Send Email</span>
            <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
          </a>

          <button
            id="copy-email"
            type="button"
            data-email="kesienamichaels@gmail.com"
            class="flex cursor-pointer items-center justify-center gap-2 rounded-full border border-zinc-200 bg-zinc-50 px-5 py-3 font-mono text-xs font-medium text-zinc-700 transition-colors hover:bg-zinc-100 w-full sm:w-auto"
          >
            <Icon name="lucide:copy" class="size-3.5" aria-hidden="true" />
            <span id="copy-text">Copy Email</span>
          </button>
        </div>
      </div>

      <!-- Scope of Engagement Box -->
      <div class="rounded-xl border border-zinc-200 bg-white p-4 sm:p-6 shadow-xs">
        <span class="font-mono text-xs uppercase tracking-widest text-zinc-400">
          // ENGAGEMENT_TYPES
        </span>

        <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div class="rounded-lg border border-zinc-100 bg-zinc-50/70 p-3.5">
            <div class="flex items-center gap-2 font-mono text-xs font-semibold text-zinc-800">
              <span class="size-1.5 rounded-full bg-blue-500"></span>
              Full-Stack Architecture
            </div>
            <p class="mt-1.5 text-xs leading-relaxed text-zinc-500">
              Next.js, TypeScript, PostgreSQL, Prisma, real-time engines, and scalable APIs.
            </p>
          </div>

          <div class="rounded-lg border border-zinc-100 bg-zinc-50/70 p-3.5">
            <div class="flex items-center gap-2 font-mono text-xs font-semibold text-zinc-800">
              <span class="size-1.5 rounded-full bg-lime-500"></span>
              AppSec & Pentesting
            </div>
            <p class="mt-1.5 text-xs leading-relaxed text-zinc-500">
              OWASP Top 10 reviews, auth/session vulnerability assessments, and IDOR testing.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Response Protocols & Verified Channels -->
    <div data-contact-right class="flex flex-col gap-6 lg:col-span-5">
      <!-- Response Protocol Telemetry -->
      <div class="rounded-xl border border-zinc-200 bg-white p-4 sm:p-6 shadow-xs">
        <span class="font-mono text-xs uppercase tracking-widest text-zinc-400">
          // RESPONSE_PROTOCOL
        </span>

        <div class="mt-4 space-y-3 font-mono text-xs">
          <div class="rounded-lg border border-zinc-100 bg-zinc-50/80 p-3">
            <span class="text-[11px] uppercase tracking-wider text-zinc-400">Response SLA</span>
            <p class="mt-1 font-semibold text-zinc-800">&lt; 24 Hours Guaranteed</p>
          </div>

          <div class="rounded-lg border border-zinc-100 bg-zinc-50/80 p-3">
            <span class="text-[11px] uppercase tracking-wider text-zinc-400">
              Location / Timezone
            </span>
            <p class="mt-1 font-semibold text-zinc-800">GMT+1 (West Africa / Remote Global)</p>
          </div>

          <div class="rounded-lg border border-zinc-100 bg-zinc-50/80 p-3">
            <span class="text-[11px] uppercase tracking-wider text-zinc-400">Security Posture</span>
            <p class="mt-1 font-semibold text-zinc-800">PGP / Verified Comm Supported</p>
          </div>
        </div>
      </div>

      <!-- Verified Social & Tech Channels -->
      <div class="flex flex-col rounded-xl border border-zinc-200 bg-white p-4 sm:p-6 shadow-xs">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-zinc-400">
            // VERIFIED_CHANNELS
          </span>

          <ul class="mt-4 divide-y divide-zinc-100">
            {channels.map((ch) => (
              <li class="py-3 first:pt-0 last:pb-0">
                <a
                  href={ch.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-between text-xs transition-colors"
                >
                  <div class="flex items-center gap-3">
                    <div class="rounded-lg border border-zinc-200 bg-zinc-50 p-2 text-zinc-600 transition-colors group-hover:border-zinc-300 group-hover:text-zinc-900">
                      <Icon name={ch.icon} class="size-4" aria-hidden="true" />
                    </div>
                    <div>
                      <p class="font-medium text-zinc-800 group-hover:text-blue-600 transition-colors">
                        {ch.name}
                      </p>
                      <p class="text-[11px] text-zinc-500 font-mono">{ch.handle}</p>
                    </div>
                  </div>
                  <Icon
                    name="lucide:arrow-up-right"
                    class="size-3.5 text-zinc-400 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-zinc-700"
                  />
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-6 border-t border-zinc-100 pt-4">
          <p class="font-mono text-[11px] text-zinc-400">
            All channels actively monitored. For sensitive disclosures, request PGP fingerprint via
            email.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Terminal Style Footer -->
  <footer class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-zinc-200 pt-6 sm:flex-row">
    <p class="font-mono text-xs text-zinc-400">
      &copy; 2026 Irikefe M. Kesiena. All rights reserved.
    </p>

    <div class="flex items-center gap-2 font-mono text-xs text-zinc-400">
      <span class="size-1.5 rounded-full bg-lime-500"></span>
      <span>ALL SYSTEMS NOMINAL</span>
    </div>
  </footer>
</main>

<script>
  import { animate } from "motion";

  function initContactPage() {
    // 1. Email copy interaction
    const btn = document.querySelector<HTMLButtonElement>("#copy-email");
    const label = document.querySelector<HTMLElement>("#copy-text");

    if (btn && label) {
      btn.addEventListener("click", async () => {
        const email = btn.dataset.email;
        if (!email) return;

        try {
          await navigator.clipboard.writeText(email);
          const originalText = label.innerText;
          label.innerText = "Copied to Clipboard!";
          btn.classList.add("text-blue-600", "border-blue-200");

          setTimeout(() => {
            label.innerText = originalText;
            btn.classList.remove("text-blue-600", "border-blue-200");
          }, 2000);
        } catch (e) {
          console.error("Clipboard copy failed:", e);
        }
      });
    }

    // 2. Motion Entrance Animation
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const header = document.querySelector<HTMLElement>("[data-contact-header]");
    const leftCol = document.querySelector<HTMLElement>("[data-contact-left]");
    const rightCol = document.querySelector<HTMLElement>("[data-contact-right]");

    if (header) {
      animate(header, { opacity: [0, 1], y: [-16, 0] }, { duration: 0.6, ease: [0.16, 1, 0.3, 1] });
    }

    if (leftCol) {
      animate(
        leftCol,
        { opacity: [0, 1], y: [28, 0] },
        { delay: 0.2, duration: 0.7, ease: [0.16, 1, 0.3, 1] }
      );
    }

    if (rightCol) {
      animate(
        rightCol,
        { opacity: [0, 1], y: [28, 0] },
        { delay: 0.35, duration: 0.7, ease: [0.16, 1, 0.3, 1] }
      );
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initContactPage);
  } else {
    initContactPage();
  }
  document.addEventListener("astro:page-load", initContactPage);
</script>
