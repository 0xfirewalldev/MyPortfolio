---
import ScrollIndicator from "../../components/ScrollIndicator.astro";
import HeroTerminal from "../../components/HeroTerminal.astro";
import { Icon } from "astro-icon/components";
---

<section
  id="home"
  class="relative flex min-h-[calc(100vh-6rem)] flex-col justify-between pt-10 pb-24 md:pt-16"
>
  <!-- Top meta status -->
  <div
    data-hero-meta
    class="flex flex-row items-center justify-between font-mono text-xs uppercase tracking-wider text-zinc-500"
  >
    <h3 class="font-mono uppercase">Full Stack Security Developer</h3>
    <div>
      <span>STACK: FULL_STACK</span>
    </div>
  </div>

  <!-- Hero Main Grid: Left Content + Right Terminal -->
  <div class="my-auto grid grid-cols-1 items-center gap-10 py-10 lg:grid-cols-12 lg:gap-12">
    <div class="flex flex-col space-y-6 lg:col-span-7">
      <h1
        data-hero-title
        class="font-display text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-zinc-700 leading-[1.08]"
      >
        Engineering <span class="italic text-blue-400">Resilience</span> & Zero-Latency Scale.
      </h1>

      <p
        data-hero-desc
        class="font-sans text-base sm:text-lg max-w-2xl leading-relaxed italic text-zinc-600"
      >
        Hi there, I’m a full-stack software developer and cybersecurity specialist operating at the
        intersection of robust application architecture and offensive vulnerability assessment.
      </p>

      <div data-hero-cta class="flex flex-wrap items-center gap-4 pt-2">
        <a
          href="/contact"
          class="flex items-center gap-2 rounded-full border border-zinc-200 bg-zinc-100 px-6 py-3 font-sans text-sm font-medium text-zinc-950 transition-colors hover:bg-zinc-300"
        >
          Lets Talk
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
        <a
          href="https://zero-js-blog.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900 px-6 py-3 font-sans text-sm font-medium text-zinc-200 transition-colors hover:bg-zinc-800"
        >
          <Icon name="lucide:zap" class="h-4 w-4" />
          Blog
        </a>
      </div>
    </div>

    <div data-hero-terminal class="w-full lg:col-span-5">
      <HeroTerminal />
    </div>
  </div>

  <div data-hero-scroll>
    <ScrollIndicator />
  </div>
</section>

<script>
  import { gsap } from "gsap";

  function initHeroAnimations() {
    const mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const meta = document.querySelector("[data-hero-meta]");
      const title = document.querySelector("[data-hero-title]");
      const desc = document.querySelector("[data-hero-desc]");
      const cta = document.querySelector("[data-hero-cta]");
      const terminal = document.querySelector("[data-hero-terminal]");
      const scroll = document.querySelector("[data-hero-scroll]");

      const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

      if (meta) {
        tl.from(meta, {
          y: -12,
          opacity: 0,
          duration: 0.6,
        });
      }

      if (title) {
        tl.from(
          title,
          {
            y: 28,
            opacity: 0,
            duration: 0.8,
          },
          "-=0.4"
        );
      }

      if (desc) {
        tl.from(
          desc,
          {
            y: 18,
            opacity: 0,
            duration: 0.7,
          },
          "-=0.5"
        );
      }

      if (cta) {
        tl.from(
          cta.children,
          {
            y: 14,
            opacity: 0,
            duration: 0.6,
            stagger: 0.12,
            ease: "power2.out",
          },
          "-=0.4"
        );
      }

      if (terminal) {
        tl.from(
          terminal,
          {
            x: 32,
            opacity: 0,
            duration: 0.9,
          },
          "-=0.7"
        );
      }

      if (scroll) {
        tl.from(
          scroll,
          {
            y: 16,
            opacity: 0,
            duration: 0.8,
          },
          "-=0.4"
        );
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroAnimations);
  } else {
    initHeroAnimations();
  }
  document.addEventListener("astro:page-load", initHeroAnimations);
</script>
