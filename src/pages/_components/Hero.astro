---
import ScrollIndicator from "../../components/ScrollIndicator.astro";
import HeroTerminal from "../../components/HeroTerminal.astro";
import { Icon } from "astro-icon/components";
---

<section
  id="home"
  class="relative flex min-h-[calc(100vh-6rem)] flex-col justify-between pt-6 pb-28 md:pt-16"
>
  <!-- Top meta status -->
  <div
    data-hero-meta
    class="flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] sm:text-xs uppercase tracking-wider text-zinc-500"
  >
    <h3 class="font-mono uppercase">Full Stack Security Developer</h3>
    <div>
      <span>STACK: FULL_STACK</span>
    </div>
  </div>

  <!-- Hero Main Grid: Left Content + Right Terminal -->
  <div class="mt-auto grid grid-cols-1 items-center gap-8 py-8 sm:gap-10 sm:py-10 lg:grid-cols-12 lg:gap-12">
    <div class="flex flex-col space-y-5 sm:space-y-6 lg:col-span-7">
      <h1
        data-hero-title
        class="font-display text-3xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-zinc-700 leading-[1.1] sm:leading-[1.08]"
      >
        Engineering <span class="italic text-blue-400">Resilience</span> & Zero-Latency Scale.
      </h1>

      <p
        data-hero-desc
        class="font-sans text-sm sm:text-lg max-w-2xl leading-relaxed italic text-zinc-600"
      >
        Hi there, I’m a full-stack software developer and cybersecurity specialist operating at the
        intersection of robust application architecture and offensive vulnerability assessment.
      </p>

      <div data-hero-cta class="flex flex-wrap items-center gap-3 sm:gap-4 pt-2">
        <a
          href="/contact"
          class="flex items-center gap-2 rounded-full border border-zinc-200 bg-zinc-100 px-5 py-2.5 sm:px-6 sm:py-3 font-sans text-xs sm:text-sm font-medium text-zinc-950 transition-colors hover:bg-zinc-300"
        >
          Lets Talk
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
        <a
          href="https://zero-js-blog.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900 px-5 py-2.5 sm:px-6 sm:py-3 font-sans text-xs sm:text-sm font-medium text-zinc-200 transition-colors hover:bg-zinc-800"
        >
          <Icon name="lucide:zap" class="h-4 w-4" />
          Blog
        </a>
      </div>
    </div>

    <div data-hero-terminal class="w-full lg:col-span-5">
      <HeroTerminal />
    </div>
  </div>

  <div data-hero-scroll class="mt-12 sm:mt-16 md:mt-20">
    <ScrollIndicator />
  </div>
</section>

<script>
  import { animate, stagger } from "motion";

  function initHeroAnimations() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const meta = document.querySelector<HTMLElement>("[data-hero-meta]");
    const title = document.querySelector<HTMLElement>("[data-hero-title]");
    const desc = document.querySelector<HTMLElement>("[data-hero-desc]");
    const cta = document.querySelector<HTMLElement>("[data-hero-cta]");
    const terminal = document.querySelector<HTMLElement>("[data-hero-terminal]");
    const scroll = document.querySelector<HTMLElement>("[data-hero-scroll]");

    const runEntrance = () => {
      if (meta) {
        animate(meta, { opacity: [0, 1], y: [-12, 0] }, { duration: 0.6, ease: [0.16, 1, 0.3, 1] });
      }

      if (title) {
        animate(
          title,
          { opacity: [0, 1], y: [28, 0] },
          { delay: 0.15, duration: 0.75, ease: [0.16, 1, 0.3, 1] }
        );
      }

      if (desc) {
        animate(
          desc,
          { opacity: [0, 1], y: [18, 0] },
          { delay: 0.28, duration: 0.7, ease: [0.16, 1, 0.3, 1] }
        );
      }

      if (cta && cta.children.length > 0) {
        animate(
          Array.from(cta.children) as HTMLElement[],
          { opacity: [0, 1], y: [14, 0] },
          { delay: stagger(0.1, { start: 0.38 }), duration: 0.6, ease: [0.16, 1, 0.3, 1] }
        );
      }

      if (terminal) {
        animate(
          terminal,
          { opacity: [0, 1], x: [32, 0] },
          { delay: 0.3, duration: 0.85, ease: [0.16, 1, 0.3, 1] }
        );
      }

      if (scroll) {
        animate(
          scroll,
          { opacity: [0, 1], y: [16, 0] },
          { delay: 0.65, duration: 0.75, ease: [0.16, 1, 0.3, 1] }
        );
      }
    };

    const splash = document.getElementById("splash-screen");
    if (splash && !sessionStorage.getItem("portfolio_booted")) {
      document.addEventListener("splash-finished", runEntrance, { once: true });
    } else {
      runEntrance();
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroAnimations);
  } else {
    initHeroAnimations();
  }
  document.addEventListener("astro:page-load", initHeroAnimations);
</script>
