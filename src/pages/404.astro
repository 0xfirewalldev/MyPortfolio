---
import Layout from "../layout/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout
  title="404 — Endpoint Not Found | Irikefe M. Kesiena"
  description="The requested route does not exist."
>
  <main class="relative flex min-h-[calc(100vh-14rem)] flex-col justify-center py-12">
    <!-- Top System Header -->
    <div class="flex items-center justify-between border-b border-zinc-200 pb-3 font-mono text-xs uppercase tracking-widest text-zinc-500">
      <span class="flex items-center gap-2 text-red-500 font-semibold">
        <span class="size-2 animate-pulse rounded-full bg-red-500"></span>
        SYS_ALERT // ERROR_404
      </span>
      <span>ENDPOINT_UNREACHABLE</span>
    </div>

    <!-- Error Hero Content -->
    <div class="my-auto py-12 text-center md:py-16">
      <span class="font-mono text-xs font-semibold uppercase tracking-widest text-blue-500">
        // HTTP_STATUS_404
      </span>

      <h1 class="font-display mt-3 text-7xl font-bold tracking-tight text-zinc-900 sm:text-8xl md:text-9xl">
        404
      </h1>

      <p class="font-mono mt-2 text-sm uppercase tracking-wider text-zinc-500">
        RESOURCE_NOT_FOUND // PACKET_DROPPED
      </p>

      <p class="mx-auto mt-4 max-w-lg text-sm leading-relaxed text-zinc-600 sm:text-base">
        The route you are attempting to access does not exist or has been decommissioned by security
        policy. Verify the target URI or reroute to a known gateway.
      </p>

      <!-- Terminal Diagnostic Box -->
      <div class="mx-auto mt-8 max-w-md rounded-xl border border-zinc-800 bg-zinc-950 p-4 text-left font-mono text-xs text-zinc-300 shadow-xl">
        <div class="flex items-center gap-1.5 border-b border-zinc-800 pb-2.5 text-zinc-500 text-[11px]">
          <span class="size-2 rounded-full bg-red-500/80"></span>
          <span class="size-2 rounded-full bg-amber-500/80"></span>
          <span class="size-2 rounded-full bg-lime-500/80"></span>
          <span class="ml-2">~/diagnostics/traceroute</span>
        </div>

        <div class="mt-3 space-y-1.5 leading-relaxed text-zinc-400">
          <p>
            <span class="text-lime-400">$</span> ping -c 1 target.gateway
          </p>
          <p class="text-red-400">&gt; Request timeout: 404 Packet dropped at ingress</p>
          <p>
            <span class="text-lime-400">$</span> resolve --host root
          </p>
          <p class="text-zinc-500">&gt; Fallback available: http://localhost:4321/</p>
        </div>
      </div>

      <!-- Action Navigation Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="flex items-center gap-2 rounded-full bg-zinc-900 px-6 py-3 font-sans text-sm font-medium text-zinc-100 transition-colors hover:bg-zinc-800"
        >
          <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
          <span>Return Home</span>
        </a>

        <a
          href="/works"
          class="flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-5 py-3 font-sans text-sm font-medium text-zinc-700 transition-colors hover:bg-zinc-50 hover:text-zinc-900"
        >
          <Icon name="lucide:briefcase-business" class="size-4 text-zinc-500" aria-hidden="true" />
          <span>Explore Works</span>
        </a>

        <a
          href="/contact"
          class="flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-5 py-3 font-sans text-sm font-medium text-zinc-700 transition-colors hover:bg-zinc-50 hover:text-zinc-900"
        >
          <Icon name="lucide:mail" class="size-4 text-zinc-500" aria-hidden="true" />
          <span>Contact Gateway</span>
        </a>
      </div>
    </div>
  </main>
</Layout>
